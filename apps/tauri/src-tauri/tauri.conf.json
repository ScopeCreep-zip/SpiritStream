{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpiritStream",
  "version": "1.2.1",
  "identifier": "com.spiritstream.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @spiritstream/web dev",
    "beforeBuildCommand": "pnpm --filter @spiritstream/web build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
      "devCsp": "default-src 'self' http://localhost:* http://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "../../../LICENSE",
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright (c) 2024-2025 SpiritStream Contributors",
    "externalBin": [
      "binaries/spiritstream-server",
      "binaries/ffmpeg"
    ],
    "resources": {
      "../../../themes/*.jsonc": "themes/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": false,
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "9592360f-57ac-57d1-bcaf-fdcad7caf89e"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "usr/share/icons/hicolor/512x512/apps/spiritstream.png": "icons/icon.png",
          "usr/share/applications/spiritstream.desktop": "linux/spiritstream.desktop"
        }
      },
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      },
      "rpm": {
        "depends": [
          "ffmpeg"
        ]
      }
    },
    "shortDescription": "Multi-destination streaming application",
    "longDescription": "SpiritStream allows you to stream to multiple platforms simultaneously at different bitrates. Configure output groups with custom encoding settings and stream to YouTube, Twitch, Kick, Facebook, and custom RTMP servers.",
    "category": "Video",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ScopeCreep-zip/SpiritStream/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_OUTPUT_OF__tauri_signer_generate",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
