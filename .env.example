# Frontend
VITE_BACKEND_MODE=http
VITE_BACKEND_URL=http://127.0.0.1:8008
VITE_BACKEND_WS_URL=ws://127.0.0.1:8008/ws
# Note: Authentication now uses HttpOnly cookies - no token needed in frontend

# Backend server
SPIRITSTREAM_HOST=127.0.0.1
SPIRITSTREAM_PORT=8008
SPIRITSTREAM_DATA_DIR=./data
SPIRITSTREAM_LOG_DIR=./data/logs
SPIRITSTREAM_THEMES_DIR=./themes
SPIRITSTREAM_UI_DIR=./dist
SPIRITSTREAM_UI_ENABLED=0

# OAuth credentials (optional overrides for embedded placeholders)
SPIRITSTREAM_TWITCH_CLIENT_ID=
SPIRITSTREAM_TWITCH_CLIENT_SECRET=
SPIRITSTREAM_YOUTUBE_CLIENT_ID=
# Google Desktop apps require client_secret even with PKCE
SPIRITSTREAM_YOUTUBE_CLIENT_SECRET=
SPIRITSTREAM_TROVO_CLIENT_ID=

# Security settings
# API token for authentication (leave empty to disable auth). In cloud
# mode this MUST be set to a ≥32-character secret — startup will refuse
# weak/absent tokens.
SPIRITSTREAM_API_TOKEN=

# Deploy mode: `desktop` (default; localhost-only, no TLS required) or
# `cloud` (server-on-the-internet — startup refuses to start without
# TLS attestation + a ≥32-char token + an explicit CORS allow-list).
SPIRITSTREAM_DEPLOY_MODE=desktop

# Required when DEPLOY_MODE=cloud: attests that a TLS-terminating
# reverse proxy (Caddy / nginx / cloud LB) is in front and the server
# can trust `X-Forwarded-Proto`. Without it cloud mode refuses to start.
SPIRITSTREAM_BEHIND_TLS_PROXY=

# Session-cookie attribute mode override. Auto-detected from host
# (localhost → LocalhostDev; cloud → CrossOrigin; Tauri webview →
# SameOrigin); set this only to override the probe for testing.
# Values: `same-origin` | `cross-origin` | `localhost-dev`
SPIRITSTREAM_COOKIE_MODE=

# Secret-store backend override. Default: platform probe selects
# `keyring` (macOS Keychain / Windows Credential Manager / Linux
# Secret Service) when available, falls back to `file` (encrypted on
# disk under the machine key). Set to force one path. Selected ONCE at
# startup — no runtime fallback. Values: `keyring` | `file`
SPIRITSTREAM_SECRET_STORE=

# CORS allowed origins (comma-separated, supports wildcard ports with :*)
# Examples:
#   http://localhost:5173                    - specific origin
#   http://localhost:*,http://127.0.0.1:*    - wildcard ports (default)
#   https://app.example.com                  - production domain
#
# CLOUD MODE (`SPIRITSTREAM_DEPLOY_MODE=cloud`) REFUSES WILDCARDS — the
# `*` value and the `:*` port wildcard are both rejected at startup
# because credentialed cross-origin browser requests must be pinned to
# specific origins. For cloud deployments, list every browser origin
# explicitly: `https://stream.example.com,https://admin.example.com`.
SPIRITSTREAM_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Rate limiting (requests per minute, default: 100)
SPIRITSTREAM_RATE_LIMIT=100

# Launcher
SPIRITSTREAM_UI_URL=http://127.0.0.1:8008
SPIRITSTREAM_SERVER_PATH=
SPIRITSTREAM_LAUNCHER_HIDE_WINDOW=0
SPIRITSTREAM_LAUNCHER_OPEN_EXTERNAL=0
