{
  "name": "@spiritstream/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed ApiClient interface + HttpClient implementation. The only path through which frontends talk to the spiritstream backend.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "regenerate": "../../scripts/regenerate-openapi.sh ./openapi.json && pnpm exec openapi-ts --input ./openapi.json --output ./src/generated --client fetch && rm ./openapi.json"
  },
  "dependencies": {
    "@spiritstream/types": "workspace:*"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.85.0",
    "typescript": "^6.0.3"
  }
}
