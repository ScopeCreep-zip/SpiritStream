{
  "name": "@spiritstream/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed ApiClient interface + HttpClient implementation. The only path through which frontends talk to the spiritstream backend.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "regenerate": "../../scripts/regenerate-openapi.sh ./openapi.json && pnpm exec openapi-ts --input ./openapi.json --output ./src/generated --client @hey-api/client-fetch && rm ./openapi.json"
  },
  "dependencies": {
    "@spiritstream/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.85.0",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
