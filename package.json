{
  "name": "spiritstream",
  "version": "1.2.1",
  "description": "SpiritStream - Multi-Destination Streaming Application",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "generate:platforms": "tsx scripts/generate-platforms.ts",
    "build:server": "tsx scripts/build-server.ts",
    "build:server:release": "tsx scripts/build-server.ts --release",
    "fetch:ffmpeg": "tsx scripts/fetch-bundled-ffmpeg.ts",
    "dev": "pnpm run dev:desktop",
    "dev:web": "pnpm --filter @spiritstream/web dev",
    "dev:desktop": "pnpm --filter @spiritstream/tauri dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @spiritstream/web build",
    "build:desktop": "pnpm --filter @spiritstream/tauri build",
    "backend:dev": "cargo run --manifest-path server/Cargo.toml",
    "backend:build": "cargo build --manifest-path server/Cargo.toml --release",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "pnpm --filter @spiritstream/web lint:fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\"",
    "check:server": "cargo check --manifest-path server/Cargo.toml",
    "check:desktop": "cargo check --manifest-path apps/tauri/src-tauri/Cargo.toml",
    "clean": "rm -rf .turbo apps/*/.turbo apps/*/dist apps/*/node_modules/.vite apps/*/node_modules/.cache",
    "clean:all": "pnpm clean && rm -rf server/target apps/tauri/src-tauri/target",
    "clean:build": "pnpm clean && pnpm build",
    "clean:build:web": "pnpm clean && pnpm build:web",
    "lint:commits": "commitlint --from=HEAD~10 --to=HEAD --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScopeCreep-zip/SpiritStream.git"
  },
  "keywords": [
    "streaming",
    "rtmp",
    "ffmpeg",
    "tauri",
    "multi-stream",
    "broadcast",
    "obs-alternative",
    "desktop-app"
  ],
  "author": "SpiritStream Contributors",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20.0.0 <21.0.0 || >=22.0.0 <23.0.0 || >=24.0.0 <25.0.0"
  },
  "bugs": {
    "url": "https://github.com/ScopeCreep-zip/SpiritStream/issues"
  },
  "homepage": "https://github.com/ScopeCreep-zip/SpiritStream#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.60.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4"
  },
  "spiritstream:notes:pnpmOverrides": "Workspace-wide transitive-dep version floors. Every entry maps to one or more RustSec / GitHub advisories surfaced by `pnpm audit --audit-level=high`. Each upgrade is the smallest semver-major-compatible bump that clears the advisory; the originating package is on the right of the comment so we can drop the override once it ships a clean release. Re-audit and trim this list quarterly.",
  "pnpm": {
    "overrides": {
      "handlebars": "^4.7.9",
      "minimatch": "^9.0.7",
      "rollup": "^4.59.0",
      "flatted": "^3.4.2",
      "brace-expansion": "^2.0.3",
      "picomatch": "^4.0.4",
      "vite": "^7.3.2",
      "postcss": "^8.5.10"
    }
  }
}
